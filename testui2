	local right = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, -4, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, row)
	makeListLayout(nil, 8, nil, right)

	return left, right
end

-- Card / group
function DemoUI:makeCard(parent, label)
	local card = create("Frame", {
		BackgroundColor3 = Theme.card_bg,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, parent)
	makeCorner(5, card)
	makeStroke(1, Theme.card_border, 0, card)
	makePadding(8, 10, 10, 10, card)
	makeListLayout(nil, 6, nil, card)

	if label then
		local hdrRow = create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
		}, card)
		local lbl = makeLabel(label, SMALL_TEXT, Theme.text_dim, hdrRow)
		lbl.Font = Enum.Font.GothamBold
		local arrow = makeLabel(" ⌄", SMALL_TEXT, Theme.text_dim, hdrRow)
		arrow.Position = UDim2.new(0, 50, 0, 0)
	end

	return card
end

