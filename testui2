-- Label
local function makeLabel(text, size, color, parent, bold)
	return create("TextLabel", {
		Text = text,
		TextSize = size or BASE_TEXT,
		TextColor3 = color or Theme.text,
		Font = bold and Enum.Font.GothamBold or Font,
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.XY,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
end

-- Checkbox
local function makeCheckbox(parent, label, default, callback)
	local row = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, parent)

	local box = create("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, 0, 0.5, -6),
		BackgroundColor3 = Theme.control_bg,
	}, row)
	makeCorner(2, box)
	makeStroke(1, Theme.control_border, 0, box)

	local check = create("TextLabel", {
		Text = "✓",
		TextSize = 9,
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.accent,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Visible = default or false,
	}, box)

	local lbl = create("TextLabel", {
		Text = label,
		TextSize = LABEL_TEXT,
		Font = Font,
		TextColor3 = Theme.text_dim,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 0),
		Size = UDim2.new(1, -18, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, row)

	local state = default or false
	local btn = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
	}, row)

	btn.MouseButton1Click:Connect(function()
		state = not state
		check.Visible = state
		if state then
			tween(lbl, { TextColor3 = Theme.text })
		else
			tween(lbl, { TextColor3 = Theme.text_dim })
		end
		if callback then callback(state) end
	end)

	btn.MouseEnter:Connect(function()
		tween(lbl, { TextColor3 = Theme.text })
	end)
	btn.MouseLeave:Connect(function()
		if not state then tween(lbl, { TextColor3 = Theme.text_dim }) end
	end)

	return row, function() return state end
end

-- Dropdown
local function makeDropdown(parent, options, default, callback)
	local selected = default or options[1]
	local open = false

	local wrapper = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
		ClipsDescendants = false,
		ZIndex = 5,
	}, parent)

	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.control_bg,
		Text = "",
		ZIndex = 5,
	}, wrapper)
	makeCorner(4, btn)
	makeStroke(1, Theme.control_border, 0, btn)
	makePadding(0, 8, 0, 10, btn)

	local selectedLbl = create("TextLabel", {
		Text = selected,
		TextSize = LABEL_TEXT,
		Font = Font,
		TextColor3 = Theme.text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -16, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
	}, btn)

	local arrow = create("TextLabel", {
		Text = "⌄",
		TextSize = 12,
		Font = Font,
		TextColor3 = Theme.text_dim,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 16, 1, 0),
		Position = UDim2.new(1, -16, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 5,
	}, btn)

	local popup = create("Frame", {
		BackgroundColor3 = Theme.popup_bg,
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.new(0, 0, 1, 2),
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 20,
	}, wrapper)
	makeCorner(4, popup)
	makeStroke(1, Theme.popup_border, 0, popup)
	makePadding(4, 0, 4, 0, popup)

	local popupList = makeListLayout(nil, 0, nil, popup)

	for _, opt in ipairs(options) do
		local optBtn = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = Theme.popup_bg,
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 20,
		}, popup)
		makePadding(0, 8, 0, 10, optBtn)

		local optLbl = create("TextLabel", {
			Text = opt,
			TextSize = LABEL_TEXT,
			Font = Font,
			TextColor3 = opt == selected and Theme.text or Theme.text_dim,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 20,
		}, optBtn)

		optBtn.MouseEnter:Connect(function()
			tween(optBtn, { BackgroundTransparency = 0 })
			tween(optLbl, { TextColor3 = Theme.text })
		end)
		optBtn.MouseLeave:Connect(function()
			tween(optBtn, { BackgroundTransparency = 1 })
			if opt ~= selected then tween(optLbl, { TextColor3 = Theme.text_dim }) end
		end)
		optBtn.MouseButton1Click:Connect(function()
			selected = opt
			selectedLbl.Text = opt
			open = false
			TweenService:Create(popup, TI_MED, { Size = UDim2.new(1, 0, 0, 0) }):Play()
			task.delay(0.2, function() popup.Visible = false end)
			if callback then callback(opt) end
		end)
	end

	local totalH = #options * 24 + 8
	btn.MouseButton1Click:Connect(function()
		open = not open
		if open then
			popup.Visible = true
			popup.Size = UDim2.new(1, 0, 0, 0)
			TweenService:Create(popup, TI_MED, { Size = UDim2.new(1, 0, 0, totalH) }):Play()
		else
			TweenService:Create(popup, TI_MED, { Size = UDim2.new(1, 0, 0, 0) }):Play()
			task.delay(0.2, function() popup.Visible = false end)
		end
	end)

	btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_hov }) end)
	btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)

	return wrapper
end

-- Slider
local function makeSlider(parent, label, min, max, default, callback)
	local val = default or min

	local container = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
	}, parent)

	local topRow = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 14),
	}, container)

	makeLabel(label, SMALL_TEXT, Theme.text_dim, topRow)

	local valLbl = create("TextLabel", {
		Text = tostring(val),
		TextSize = SMALL_TEXT,
		Font = FontMono,
		TextColor3 = Theme.text_dim,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Right,
	}, topRow)

	local track = create("Frame", {
		BackgroundColor3 = Theme.slider_track,
		Size = UDim2.new(1, 0, 0, 3),
		Position = UDim2.new(0, 0, 0, 20),
		BorderSizePixel = 0,
	}, container)
	makeCorner(2, track)

	local fill = create("Frame", {
		BackgroundColor3 = Theme.accent,
		Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
		BorderSizePixel = 0,
	}, track)
	makeCorner(2, fill)

	local handle = create("Frame", {
		Size = UDim2.new(0, 7, 0, 7),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new((val - min) / (max - min), 0, 0.5, 0),
		BackgroundColor3 = Theme.accent,
		ZIndex = 2,
	}, track)
	makeCorner(4, handle)

	local dragging = false
	local inputBegan = track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
		end
	end)

	local inputChanged = UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local trackPos = track.AbsolutePosition.X
			local trackSize = track.AbsoluteSize.X
			local rel = math.clamp((Mouse.X - trackPos) / trackSize, 0, 1)
			val = math.floor(min + rel * (max - min) + 0.5)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			handle.Position = UDim2.new(rel, 0, 0.5, 0)
			valLbl.Text = tostring(val)
			if callback then callback(val) end
		end
	end)

	local inputEnded = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	return container
end

-- Keybind button
local function makeKeybind(parent, default)
	local key = default or "NONE"
	local listening = false

	local btn = create("TextButton", {
		Size = UDim2.new(0, 70, 0, 22),
		BackgroundColor3 = Theme.control_bg,
		Text = "key: " .. key,
		TextSize = SMALL_TEXT,
		Font = FontMono,
		TextColor3 = Theme.text_dim,
	}, parent)
	makeCorner(4, btn)
	makeStroke(1, Theme.control_border, 0, btn)

	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		btn.Text = "..."
		btn.TextColor3 = Theme.accent
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		if not listening then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			key = input.KeyCode.Name
			btn.Text = "key: " .. key
			btn.TextColor3 = Theme.text_dim
			listening = false
		end
	end)

	btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_hov }) end)
	btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)

	return btn
end

-- Button (generic action)
local function makeButton(parent, label, callback)
	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.control_bg,
		Text = label,
		TextSize = LABEL_TEXT,
		Font = Font,
		TextColor3 = Theme.text,
	}, parent)
	makeCorner(4, btn)
	makeStroke(1, Theme.control_border, 0, btn)

	btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_hov }) end)
	btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)
	btn.MouseButton1Click:Connect(function()
		tween(btn, { BackgroundColor3 = Theme.accent })
		task.delay(0.12, function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)
		if callback then callback() end
	end)

	return btn
end

-- TextInput
local function makeTextInput(parent, default, placeholder)
	local box = create("TextBox", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.control_bg,
		Text = default or "",
		PlaceholderText = placeholder or "",
		TextSize = LABEL_TEXT,
		Font = Font,
		TextColor3 = Theme.text,
		PlaceholderColor3 = Theme.text_dim,
		ClearTextOnFocus = false,
	}, parent)
	makeCorner(4, box)
	makeStroke(1, Theme.control_border, 0, box)
	makePadding(0, 8, 0, 8, box)

	box.Focused:Connect(function() tween(makeStroke(1, Theme.accent, 0, box), {}) end)

	return box
end

