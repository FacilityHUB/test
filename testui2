function DemoUI:addTab(name, buildFn)
	local tabBtn = self._tabButtons[name]
	if not tabBtn then return end

	local page = create("ScrollingFrame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.card_border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 2,
	}, self._content)
	makePadding(10, 10, 10, 10, page)

	self._tabs[name] = page

	if buildFn then buildFn(page) end

	tabBtn.MouseButton1Click:Connect(function()
		self:_switchTab(name)
	end)
	tabBtn.MouseEnter:Connect(function()
		if self._activeTab ~= name then
			tween(tabBtn, { TextColor3 = Theme.text })
		end
	end)
	tabBtn.MouseLeave:Connect(function()
		if self._activeTab ~= name then
			tween(tabBtn, { TextColor3 = Theme.text_dim })
		end
	end)

	if not self._activeTab then
		self:_switchTab(name)
	end
end

function DemoUI:_switchTab(name)
	if self._activeTab then
		local prev = self._tabs[self._activeTab]
		local prevBtn = self._tabButtons[self._activeTab]
		if prev then prev.Visible = false end
		if prevBtn then tween(prevBtn, { TextColor3 = Theme.text_dim }) end
	end
	self._activeTab = name
	local page = self._tabs[name]
	local btn = self._tabButtons[name]
	if page then page.Visible = true end
	if btn then tween(btn, { TextColor3 = Theme.text }) end
end

