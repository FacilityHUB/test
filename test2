local function makeCheckbox(parent, label, default, callback)
	local row = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
	}, parent)

	local box = create("Frame", {
		Size             = UDim2.new(0, 12, 0, 12),
		Position         = UDim2.new(0, 0, 0.5, -6),
		BackgroundColor3 = Theme.control_bg,
	}, row)
	makeCorner(2, box)
	makeStroke(1, Theme.control_border, 0, box)

	local check = create("TextLabel", {
		Text               = "✓",
		TextSize           = 9,
		Font               = Enum.Font.GothamBold,
		TextColor3         = Theme.accent,
		BackgroundTransparency = 1,
		Size               = UDim2.fromScale(1, 1),
		TextXAlignment     = Enum.TextXAlignment.Center,
		TextYAlignment     = Enum.TextYAlignment.Center,
		Visible            = default or false,
	}, box)

	local lbl = create("TextLabel", {
		Text               = label,
		TextSize           = LABEL_TEXT,
		Font               = Font,
		TextColor3         = default and Theme.text or Theme.text_dim,
		BackgroundTransparency = 1,
		Position           = UDim2.new(0, 18, 0, 0),
		Size               = UDim2.new(1, -18, 0, 20),
		TextXAlignment     = Enum.TextXAlignment.Left,
		TextYAlignment     = Enum.TextYAlignment.Center,
	}, row)

	local state = default or false
	local btn = create("TextButton", {
		Size               = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text               = "",
	}, row)

	btn.MouseButton1Click:Connect(function()
		state = not state
		check.Visible = state
		tween(lbl, { TextColor3 = state and Theme.text or Theme.text_dim })
		if callback then callback(state) end
	end)
	btn.MouseEnter:Connect(function() tween(lbl, { TextColor3 = Theme.text }) end)
	btn.MouseLeave:Connect(function()
		if not state then tween(lbl, { TextColor3 = Theme.text_dim }) end
	end)

	return row, function() return state end
end

-- FIX: dropdown popup parented to ScreenGui to escape ClipsDescendants
local _screenGuiRef = nil

local function makeDropdown(parent, options, default, callback)
	local selected = default or options[1]
	local open     = false

	local wrapper = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
	}, parent)

	local btn = create("TextButton", {
		Size             = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.control_bg,
		Text             = "",
	}, wrapper)
	makeCorner(4, btn)
	makeStroke(1, Theme.control_border, 0, btn)
	makePadding(0, 8, 0, 10, btn)

	local selectedLbl = create("TextLabel", {
		Text               = selected,
		TextSize           = LABEL_TEXT,
		Font               = Font,
		TextColor3         = Theme.text,
		BackgroundTransparency = 1,
		Size               = UDim2.new(1, -20, 1, 0),
		TextXAlignment     = Enum.TextXAlignment.Left,
	}, btn)

	create("TextLabel", {
		Text               = "∨",
		TextSize           = 9,
		Font               = Enum.Font.GothamBold,
		TextColor3         = Theme.text_dim,
		BackgroundTransparency = 1,
		Size               = UDim2.new(0, 16, 1, 0),
		Position           = UDim2.new(1, -18, 0, 0),
		TextXAlignment     = Enum.TextXAlignment.Center,
	}, btn)

	-- Popup parented to ScreenGui (ZIndex global), positioned dynamically
	local popup = create("Frame", {
		BackgroundColor3 = Theme.popup_bg,
		Size             = UDim2.new(0, 0, 0, 0),
		Visible          = false,
		ZIndex           = 50,
		ClipsDescendants = true,
	}, _screenGuiRef)
	makeCorner(4, popup)
	makeStroke(1, Theme.popup_border, 0, popup)
	makePadding(4, 0, 4, 0, popup)
	makeListLayout(nil, 0, popup)

	local totalH = #options * 24 + 8

	local function updatePopupPosition()
		local absPos  = btn.AbsolutePosition
		local absSize = btn.AbsoluteSize
		popup.Size     = UDim2.new(0, absSize.X, 0, 0)
		popup.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
	end

	for _, opt in ipairs(options) do
		local optBtn = create("TextButton", {
			Size             = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = Theme.popup_bg,
			BackgroundTransparency = 1,
			Text             = "",
			ZIndex           = 50,
		}, popup)
		makePadding(0, 8, 0, 10, optBtn)

		local optLbl = create("TextLabel", {
			Text               = opt,
			TextSize           = LABEL_TEXT,
			Font               = Font,
			TextColor3         = opt == selected and Theme.text or Theme.text_dim,
			BackgroundTransparency = 1,
			Size               = UDim2.fromScale(1, 1),
			TextXAlignment     = Enum.TextXAlignment.Left,
			ZIndex             = 50,
		}, optBtn)

		optBtn.MouseEnter:Connect(function()
			tween(optBtn, { BackgroundTransparency = 0 })
			tween(optLbl, { TextColor3 = Theme.text })
		end)
		optBtn.MouseLeave:Connect(function()
			tween(optBtn, { BackgroundTransparency = 1 })
			if opt ~= selected then tween(optLbl, { TextColor3 = Theme.text_dim }) end
		end)
		optBtn.MouseButton1Click:Connect(function()
			selected = opt
			selectedLbl.Text = opt
			open = false
			TweenService:Create(popup, TI_MED, { Size = UDim2.new(0, popup.AbsoluteSize.X, 0, 0) }):Play()
			task.delay(0.2, function() popup.Visible = false end)
			if callback then callback(opt) end
		end)
	end

	btn.MouseButton1Click:Connect(function()
		open = not open
		if open then
			updatePopupPosition()
			popup.Visible = true
			local w = btn.AbsoluteSize.X
			TweenService:Create(popup, TI_MED, { Size = UDim2.new(0, w, 0, totalH) }):Play()
		else
			TweenService:Create(popup, TI_MED, { Size = UDim2.new(0, popup.AbsoluteSize.X, 0, 0) }):Play()
			task.delay(0.2, function() popup.Visible = false end)
		end
	end)

	-- Close popup when clicking outside
	UserInputService.InputBegan:Connect(function(input)
		if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
			local pos = input.Position
			local ap  = popup.AbsolutePosition
			local as  = popup.AbsoluteSize
			local ab  = btn.AbsolutePosition
			local abs = btn.AbsoluteSize
			local inPopup = pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
			local inBtn   = pos.X >= ab.X and pos.X <= ab.X + abs.X and pos.Y >= ab.Y and pos.Y <= ab.Y + abs.Y
			if not inPopup and not inBtn then
				open = false
				TweenService:Create(popup, TI_MED, { Size = UDim2.new(0, popup.AbsoluteSize.X, 0, 0) }):Play()
				task.delay(0.2, function() popup.Visible = false end)
			end
		end
	end)

	btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_hov }) end)
	btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)

	return wrapper
end

-- FIX: slider using InputChanged on UserInputService, no Mouse dependency
local function makeSlider(parent, label, min, max, default, callback)
	local val = math.clamp(default or min, min, max)

	local container = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 36),
	}, parent)

	local topRow = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 14),
	}, container)

	create("TextLabel", {
		Text               = label,
		TextSize           = SMALL_TEXT,
		Font               = Font,
		TextColor3         = Theme.text_dim,
		BackgroundTransparency = 1,
		Size               = UDim2.new(1, -30, 1, 0),
		TextXAlignment     = Enum.TextXAlignment.Left,
	}, topRow)

	local valLbl = create("TextLabel", {
		Text               = tostring(val),
		TextSize           = SMALL_TEXT,
		Font               = FontMono,
		TextColor3         = Theme.text_dim,
		BackgroundTransparency = 1,
		Size               = UDim2.new(0, 30, 1, 0),
		Position           = UDim2.new(1, -30, 0, 0),
		TextXAlignment     = Enum.TextXAlignment.Right,
	}, topRow)

	local track = create("Frame", {
		BackgroundColor3 = Theme.slider_track,
		Size             = UDim2.new(1, 0, 0, 3),
		Position         = UDim2.new(0, 0, 0, 22),
		BorderSizePixel  = 0,
	}, container)
	makeCorner(2, track)

	local ratio = (val - min) / math.max(max - min, 1)

	local fill = create("Frame", {
		BackgroundColor3 = Theme.accent,
		Size             = UDim2.new(ratio, 0, 1, 0),
		BorderSizePixel  = 0,
	}, track)
	makeCorner(2, fill)

	local handle = create("Frame", {
		Size            = UDim2.new(0, 8, 0, 8),
		AnchorPoint     = Vector2.new(0.5, 0.5),
		Position        = UDim2.new(ratio, 0, 0.5, 0),
		BackgroundColor3 = Theme.accent,
		ZIndex          = 2,
	}, track)
	makeCorner(4, handle)

	local hitbox = create("TextButton", {
		Size               = UDim2.new(1, 0, 0, 16),
		Position           = UDim2.new(0, 0, 0.5, -8),
		BackgroundTransparency = 1,
		Text               = "",
		ZIndex             = 3,
	}, track)

	local dragging = false

	local function applyX(mouseX)
		local ap = track.AbsolutePosition.X
		local as = track.AbsoluteSize.X
		local r  = math.clamp((mouseX - ap) / math.max(as, 1), 0, 1)
		val = math.floor(min + r * (max - min) + 0.5)
		fill.Size     = UDim2.new(r, 0, 1, 0)
		handle.Position = UDim2.new(r, 0, 0.5, 0)
		valLbl.Text   = tostring(val)
		if callback then callback(val) end
	end

	hitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			applyX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			applyX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	return container
end

local function makeKeybind(parent, default)
	local key      = default or "NONE"
	local listening = false

	local btn = create("TextButton", {
		Size             = UDim2.new(0, 74, 0, 22),
		BackgroundColor3 = Theme.control_bg,
		Text             = "key: " .. key,
		TextSize         = SMALL_TEXT,
		Font             = FontMono,
		TextColor3       = Theme.text_dim,
	}, parent)
	makeCorner(4, btn)
	makeStroke(1, Theme.control_border, 0, btn)

	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening  = true
		btn.Text   = "..."
		tween(btn, { TextColor3 = Theme.accent })
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not listening then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			key        = input.KeyCode.Name
			btn.Text   = "key: " .. key
			listening  = false
			tween(btn, { TextColor3 = Theme.text_dim })
		end
	end)

	btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_hov }) end)
	btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)

	return btn
end

local function makeButton(parent, label, callback)
	local btn = create("TextButton", {
		Size             = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.control_bg,
		Text             = label,
		TextSize         = LABEL_TEXT,
		Font             = Font,
		TextColor3       = Theme.text,
	}, parent)
	makeCorner(4, btn)
	makeStroke(1, Theme.control_border, 0, btn)

	btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_hov }) end)
	btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)
	btn.MouseButton1Click:Connect(function()
		tween(btn, { BackgroundColor3 = Theme.accent })
		task.delay(0.12, function() tween(btn, { BackgroundColor3 = Theme.control_bg }) end)
		if callback then callback() end
	end)

	return btn
end

local function makeTextInput(parent, default, placeholder)
	local box = create("TextBox", {
		Size               = UDim2.new(1, 0, 0, 26),
		BackgroundColor3   = Theme.control_bg,
		Text               = default or "",
		PlaceholderText    = placeholder or "",
		TextSize           = LABEL_TEXT,
		Font               = Font,
		TextColor3         = Theme.text,
		PlaceholderColor3  = Theme.text_dim,
		ClearTextOnFocus   = false,
	}, parent)
	makeCorner(4, box)
	makeStroke(1, Theme.control_border, 0, box)
	makePadding(0, 8, 0, 8, box)
	return box
end

local function makeColorSwatch(parent, color)
	local swatch = create("TextButton", {
		Size             = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = color or Theme.accent,
		Text             = "",
	}, parent)
	makeCorner(3, swatch)
	makeStroke(1, Theme.control_border, 0, swatch)
	return swatch
end

