	end
end))

function Library:Destroy()
	for _, conn in ipairs(self.Connections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(self.Connections)
	for _, w in ipairs(self.Windows) do
		w.Gui:Destroy()
	end
	table.clear(self.Windows)
	if self.NotifyGui then self.NotifyGui:Destroy() self.NotifyGui = nil end
	if self.MobileGui then self.MobileGui:Destroy() self.MobileGui = nil self.MobileButton = nil end
	table.clear(self.Registry)
	table.clear(self.Flags)
end

local HttpService = game:GetService("HttpService")

local FileSystem = {}
FileSystem.Memory = {}
FileSystem.Native = typeof(writefile) == "function" and typeof(readfile) == "function"

function FileSystem:MakeFolder(path)
	if not self.Native then return end
	if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
		local ok, exists = pcall(isfolder, path)
		if ok and not exists then pcall(makefolder, path) end
	end
end

function FileSystem:Write(path, text)
	if self.Native and pcall(writefile, path, text) then
		self.Memory[path] = nil
		return true
	end
	self.Memory[path] = text
	return true
end

function FileSystem:Read(path)
	if self.Native and typeof(isfile) == "function" then
		local ok, exists = pcall(isfile, path)
		if ok and exists then
			local read, data = pcall(readfile, path)
			if read then return data end
		end
	end
	return self.Memory[path]
end

function FileSystem:Delete(path)
	if self.Native and typeof(delfile) == "function" then pcall(delfile, path) end
	self.Memory[path] = nil
end

function FileSystem:List(folder)
	local names, seen = {}, {}
	if self.Native and typeof(listfiles) == "function" then
		local ok, files = pcall(listfiles, folder)
		if ok and files then
			for _, full in ipairs(files) do
				local name = string.match(full, "[^/\\]+$")
				if name and not seen[name] then
					seen[name] = true
					table.insert(names, name)
				end
			end
		end
	end
	for path in pairs(self.Memory) do
		if string.sub(path, 1, #folder + 1) == folder .. "/" then
			local name = string.match(path, "[^/\\]+$")
			if name and not seen[name] then
				seen[name] = true
				table.insert(names, name)
			end
		end
	end
	table.sort(names)
	return names
end

local function BuildTree(folder)
	local path = ""
	for _, part in ipairs(string.split(folder, "/")) do
		path = path == "" and part or (path .. "/" .. part)
		FileSystem:MakeFolder(path)
	end
	FileSystem:MakeFolder(folder .. "/configs")
	FileSystem:MakeFolder(folder .. "/settings")
end

local InterfaceManager = {}
InterfaceManager.Library = Library
InterfaceManager.Folder = "DemoUI"
InterfaceManager.Flags = { "interface_menu_key", "interface_scale" }

local SaveManager = {}
SaveManager.Library = Library
SaveManager.Folder = "DemoUI"
SaveManager.Ignore = {}
SaveManager.Format = "json"

function SaveManager:SetLibrary(lib)
	self.Library = lib or Library
end

function SaveManager:SetIgnoreIndexes(list)
	for _, key in ipairs(list or {}) do self.Ignore[key] = true end
end

function SaveManager:IgnoreThemeSettings()
	self:SetIgnoreIndexes(InterfaceManager.Flags)
end

function SaveManager:SetFolder(folder)
	self.Folder = folder
	BuildTree(folder)
end

function SaveManager:Path(file)
	return self.Folder .. "/configs/" .. file
end

function SaveManager:List()
	return FileSystem:List(self.Folder .. "/configs")
end

function SaveManager:Save(name)
	if type(name) ~= "string" or string.gsub(name, "%s", "") == "" then return false, "empty name" end
	local file = name
	if not string.match(file, "%.%w+$") then file = file .. "." .. self.Format end
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(self.Library:GetConfig(self.Ignore))
	end)
	if not ok then return false, "encode failed" end
	FileSystem:Write(self:Path(file), encoded)
	self.Library:ClearDirty()
	return true, file
end

function SaveManager:Load(file)
	if type(file) ~= "string" or file == "" then return false, "no config" end
	local raw = FileSystem:Read(self:Path(file))
	if not raw then return false, "not found" end
	local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok then return false, "corrupted file" end
	self.Library:LoadConfig(data, self.Ignore)
	return true, file
end

function SaveManager:Delete(file)
	if type(file) ~= "string" or file == "" then return false, "no config" end
	FileSystem:Delete(self:Path(file))
	if self:GetAutoload() == file then self:ClearAutoload() end
	return true, file
end

function SaveManager:AutoloadPath()
	return self.Folder .. "/settings/autoload.txt"
end

function SaveManager:GetAutoload()
	local name = FileSystem:Read(self:AutoloadPath())
	if name == "" then return nil end
	return name
end

function SaveManager:SetAutoload(file)
	if type(file) ~= "string" or file == "" then return false end
	FileSystem:Write(self:AutoloadPath(), file)
	return true
end

function SaveManager:ClearAutoload()
	FileSystem:Delete(self:AutoloadPath())
end

function SaveManager:LoadAutoloadConfig()
	local file = self:GetAutoload()
	if not file then return false end
	local ok, err = self:Load(file)
	self.Library:Notify({
		Title = ok and "config loaded" or "config error",
		Text = ok and file or tostring(err),
		Duration = 3,
	})
	return ok
end

function SaveManager:BuildConfigSection(tab, column)
	local section = tab:Section("configs", column or 2)
	local nameBox = section:Input({ Text = "name", Flag = false, Default = "default", Placeholder = "config name" })
	local savedBox = section:Dropdown({ Text = "saved", Flag = false, Options = self:List(), Empty = "none" })

	local autoloadLabel, dirtyLabel

	local function refreshList(select)
		savedBox:SetOptions(self:List())
		if select then savedBox:Set(select, true) end
	end

	local function selected()
		local file = savedBox:Get()
		if type(file) ~= "string" or file == "" then return nil end
		return file
	end

	local function notify(ok, result, action)
		self.Library:Notify({
			Title = ok and ("config " .. action) or "config error",
			Text = tostring(result),
			Duration = 3,
		})
	end

	section:ButtonRow({
		{
			Text = "save",
			Callback = function()
				local ok, result = self:Save(nameBox:Get())
				if ok then refreshList(result) end
				notify(ok, result, "saved")
			end,
		},
		{
			Text = "load",
			Callback = function()
				local ok, result = self:Load(selected())
				notify(ok, result, "loaded")
			end,
		},
	})

	section:ButtonRow({
		{
			Text = "delete",
			Callback = function()
				local ok, result = self:Delete(selected())
				if ok then
					refreshList()
					if autoloadLabel then autoloadLabel:Set("autoload: " .. (self:GetAutoload() or "none")) end
				end
				notify(ok, result, "deleted")
			end,
		},
		{ Text = "refresh", Callback = function() refreshList() end },
	})

	section:ButtonRow({
		{
			Text = "set autoload",
			Callback = function()
				local file = selected()
				if not file then return notify(false, "no config", "") end
				self:SetAutoload(file)
				autoloadLabel:Set("autoload: " .. file)
			end,
		},
		{
			Text = "clear autoload",
			Callback = function()
				self:ClearAutoload()
				autoloadLabel:Set("autoload: none")
			end,
		},
	})

	section:ButtonRow({
		{
			Text = "copy",
			Callback = function()
				local ok, encoded = pcall(function()
					return HttpService:JSONEncode(self.Library:GetConfig(self.Ignore))
				end)
				if ok and typeof(setclipboard) == "function" then
					setclipboard(encoded)
					notify(true, "copied to clipboard", "copied")
				else
					notify(false, "clipboard unavailable", "")
				end
			end,
		},
		{
			Text = "paste",
			Callback = function()
				local reader = typeof(getclipboard) == "function" and getclipboard or nil
				if not reader then return notify(false, "clipboard unavailable", "") end
				local ok, data = pcall(function() return HttpService:JSONDecode(reader()) end)
				if not ok or type(data) ~= "table" then return notify(false, "invalid clipboard", "") end
				self.Library:LoadConfig(data, self.Ignore)
				notify(true, "config applied", "pasted")
			end,
		},
	})

	section:ButtonRow({
		{
			Text = "reset defaults",
			Callback = function()
				self.Library:ResetDefaults(self.Ignore)
				notify(true, "defaults restored", "reset")
			end,
		},
	})

	autoloadLabel = section:Label("autoload: " .. (self:GetAutoload() or "none"))
	dirtyLabel = section:Label("no unsaved changes")

	self.Library:CaptureDefaults()
	self.Library:ClearDirty()
	self.Library.OnDirty = function(state)
		dirtyLabel:Set(state and "unsaved changes" or "no unsaved changes")
		dirtyLabel:SetColor(state and Theme.Accent or Theme.TextDim)
	end

	self.Section = section
	return section
end

function InterfaceManager:SetLibrary(lib)
	self.Library = lib or Library
end

function InterfaceManager:SetWindow(window)
	self.Window = window
end

function InterfaceManager:SetFolder(folder)
	self.Folder = folder
	BuildTree(folder)
end

function InterfaceManager:GetWindow()
	return self.Window or self.Library.Windows[1]
end

function InterfaceManager:BuildInterfaceSection(tab, column)
	self.Settings = self.Settings or { MenuKey = "RightShift", Scale = 100 }

	local section = tab:Section("interface", column or 1)
	local window = self:GetWindow()

	local menuKey = section:Keybind({
		Text = "menu key",
		Flag = "interface_menu_key",
		Default = self.Settings.MenuKey,
		OnChanged = function(key)
			self.Settings.MenuKey = key or ""
			self.Library:SetToggleKey(key)
		end,
	})

	local scale = section:Slider({
		Text = "ui scale",
		Flag = "interface_scale",
		Min = 70,
		Max = 130,
		Suffix = "%",
		Default = self.Settings.Scale,
		Callback = function(v)
			self.Settings.Scale = v
			local win = self:GetWindow()
			if win then win:SetUserScale(v / 100) end
		end,
	})

	section:Button({
		Text = "unload",
		Callback = function() self.Library:Destroy() end,
	})

	menuKey:Set(self.Settings.MenuKey)
	scale:Set(self.Settings.Scale)

	self.Section = section
	return section
end

function Library:Warn(title, text, duration)
	return self:Notify({ Title = title, Text = text, Duration = duration, Style = "warning" })
end

function Library:Error(title, text, duration)
	return self:Notify({ Title = title, Text = text, Duration = duration, Style = "danger" })
end

function Library:Success(title, text, duration)
	return self:Notify({ Title = title, Text = text, Duration = duration, Style = "success" })
end

Library.DirtyIgnore = SaveManager.Ignore
Library.FileSystem = FileSystem
Library.SaveManager = SaveManager
Library.InterfaceManager = InterfaceManager

return Library
