	pageList.SortOrder = Enum.SortOrder.LayoutOrder
	Pad(page, 2, 8, 2, 2)

	local tab = setmetatable({ Window = self, Page = page, Columns = {}, Name = name }, Tab)
	for i = 1, 2 do
		local col = New("Frame", {
			Size = UDim2.new(0.5, -11, 0, 0),
