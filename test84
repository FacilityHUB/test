		})
		List(col, 14)
		tab.Columns[i] = setmetatable({ Window = self, Frame = col, Order = 0 }, Column)
	end

	local button = New("TextButton", {
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = name,
		TextColor3 = Theme.TextDim,
		TextSize = Theme.TextSize,
		Font = Theme.Font,
		LayoutOrder = #self.Tabs + 1,
		Parent = self.TabBar,
	})

	tab.Button = button
	table.insert(self.Tabs, tab)

	Track(button.Activated:Connect(function()
		self:SetTab(tab)
	end))
	Track(button.MouseEnter:Connect(function()
		if self.ActiveTab ~= tab then Tween(button, { TextColor3 = Theme.Text }, EASE_FAST) end
	end))
	Track(button.MouseLeave:Connect(function()
		if self.ActiveTab ~= tab then Tween(button, { TextColor3 = Theme.TextDim }, EASE_FAST) end
	end))
	Track(page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		self:CloseFloating()
	end))

	if not self.ActiveTab then self:SetTab(tab) end
	return tab
end

function Window:SetTab(tab)
	if type(tab) == "string" then
		for _, t in ipairs(self.Tabs) do
			if t.Name == tab then tab = t break end
		end
	end
	if self.ActiveTab == tab then return end
	self:CloseFloating()
	if self.ActiveTab then
		self.ActiveTab.Page.Visible = false
		Tween(self.ActiveTab.Button, { TextColor3 = Theme.TextDim }, EASE_FAST)
	end
	self.ActiveTab = tab
	tab.Page.Visible = true
	tab.Page.Position = UDim2.fromOffset(0, 6)
	Tween(tab.Page, { Position = UDim2.fromOffset(0, 0) })
	Tween(tab.Button, { TextColor3 = Theme.TextBright }, EASE_FAST)
end

